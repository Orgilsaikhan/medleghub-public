# Production орчны хувьсагчид — VM дээр `.env.prod` нэрээр хуулж бөглөнө.
# ЭНЭ ФАЙЛЫГ БИТГИЙ БӨГЛӨӨРЭЙ, `.env.prod` нь git-д ордоггүй.
#
#   cp .env.prod.example .env.prod && nano .env.prod

# --- Docker image ------------------------------------------------------
# GitHub Actions-ийн бүтээсэн image-ийн tag (`.github/workflows/images.yml`):
#   latest       — main-ийн сүүлийн хувилбар
#   test         — test салбарын сүүлийн хувилбар
#   sha-abc1234  — тодорхой commit (буцаах эсвэл тогтоох)
IMAGE_TAG=latest

# --- Өгөгдлийн сан (Supabase) -----------------------------------------
# Supabase → Connect → «Session pooler» (IPv4). `db.<ref>.supabase.co`
# (Direct) нь зөвхөн IPv6 — VM-ээс хүрэхгүй. Драйвер нь `postgresql+asyncpg`,
# төгсгөлд нь `?ssl=require`. Нууц үгийн тусгай тэмдэгтийг URL-encode хийнэ
# ($ → %24, @ → %40, # → %23) — эс бөгөөс compose `$`-ийг хувьсагч гэж уншина.
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<нууц-үг>@aws-0-<бүс>.pooler.supabase.com:5432/postgres?ssl=require

# --- Нууц --------------------------------------------------------------
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# 32 тэмдэгтээс богино бол апп ЭХЛЭХГҮЙ.
JWT_SECRET=

# --- Домэйн ------------------------------------------------------------
# Домэйнгүй үед sslip.io нь IP-г hostname болгоно:
#   129.146.1.2 -> 129-146-1-2.sslip.io
# Let's Encrypt нь нүцгэн IP-д сертификат олгодоггүй тул энэ нь заавал.
# Жинхэнэ домэйн авсны дараа зүгээр л энд солино.
API_HOST=

# Let's Encrypt-ийн сануулга очих хаяг.
ACME_EMAIL=

# --- CORS --------------------------------------------------------------
# Вэбийн production URL. Cloudflare Worker `/api/v1`-ийг дамжуулдаг үед хөтөч
# API-г ижил origin гэж үздэг тул CORS хэрэглэгдэхгүй — гэхдээ тохируулсан байх
# нь шууд хандалтыг (жишээ нь локал дебаг) ажиллуулна.
CORS_ORIGINS=https://example.com

# --- Auth cookie -------------------------------------------------------
# Worker `/api/v1`-ийг дамжуулж байвал `lax` (cookie нь вэбийн домэйн дээр).
# Хэрэв rewrite-гүй, хөтөч API руу ШУУД ханддаг бол `none` болгоно —
# гэхдээ Safari дээр нэвтрэлт ажиллахгүй болохыг анхаар.
AUTH_COOKIE_SAMESITE=lax

# --- Standard багц (Wire төлбөр) ---------------------------------------
# https://docs.wire.mn — дашбоардаас. Туршилтад `sk_test_…`, бодит төлбөрт `sk_live_…`.
# Хоосон бол «Standard багц авах» нь «тохиргоо хийгдээгүй» гэж хариулна.
WIRE_SECRET_KEY=
# Webhook endpoint үүсгэхэд НЭГ Л удаа харагдах `whsec_…`. Endpoint-ийн URL:
#   https://<API_HOST>/api/v1/billing/webhooks/wire
# Хоосон бол webhook-гүй ажиллана — төлбөр буцах хуудас дээр шалгагдана.
WIRE_WEBHOOK_SECRET=
# Test mode: sandbox. Live: дашбоардад идэвхжүүлсэн операторуудын id (таслалаар).
# `GET https://api.wire.mn/v1/operator_connections`-ийн `operator` талбар.
WIRE_ALLOWED_OPERATORS=qpay
# Төлбөрийн дараа буцах frontend-ийн хаяг. Wire зөвхөн HTTPS хүлээж авна.
SITE_URL=https://example.com

# --- Имэйлийн код (Supabase Auth) --------------------------------------
# Бүртгэл баталгаажуулах, нууц үг сэргээх, имэйл солих код Supabase-ийн SMTP-ээр
# явна. Supabase → Project Settings → API Keys. Загвар, тохиргоо:
# `README.md` → «Supabase». Эхний хоёр хоосон бол API эхлэхгүй.
SUPABASE_URL=https://<ref>.supabase.co
# Publishable (эсвэл хуучин `anon`) түлхүүр.
SUPABASE_ANON_KEY=
# НУУЦ secret (эсвэл хуучин `service_role`) түлхүүр — бүртгэл устгах, имэйл
# солиход Supabase Auth дахь хуучин бичлэгийг арилгана. Хоосон бол тэнд үлдэнэ.
SUPABASE_SERVICE_ROLE_KEY=

# --- Зочны жинхэнэ IP (rate limit) -------------------------------------
# Cloudflare Worker нь `/api/v1` хүсэлтэд зочны IP-г HMAC-аар гарын үсэг зурж
# дамжуулна. Энэ утга Worker-ийн secret-тэй ИЖИЛ байна:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   (apps/web дотор) npx wrangler secret put CLIENT_IP_SECRET
# Хоосон бол бүх зочин Cloudflare-ийн нэг IP-гаар тоологдоно. 32+ тэмдэгт.
CLIENT_IP_SECRET=

# --- VM-ийн хэмжээ -----------------------------------------------------
# Хоосон бол 4 vCPU / 8 GB-д тохирсон утга (2, 2, 2). 1 vCPU / 2 GB VM дээр:
#   COMPILER_MAX_CONCURRENCY=1, COMPILER_CPUS=1, SQLRUNNER_SLOTS=2
# COMPILER_CPUS нь VM-ийн CPU-ийн тооноос их бол compiler эхлэхгүй.
COMPILER_MAX_CONCURRENCY=
COMPILER_CPUS=
SQLRUNNER_SLOTS=

# --- MedlegHub Live (AI Study) -----------------------------------------
# `off` — бүх `/live` зам 404; `admins` — зөвхөн админ (production дээр турших);
# `all` — нэвтэрсэн бүх хэрэглэгч.
LIVE_ACCESS=off
# AI provider. `auto` (хоосон) — OPENROUTER_API_KEY байвал OpenRouter, үгүй бол Gemini.
AI_PROVIDER=
# OpenRouter (https://openrouter.ai → Keys). Ижил Gemini загварууд, Google-ийн үнээр;
# карт эсвэл крипто (USDC)-ээр кредит нэмнэ. Хүсэлт бүр сургалтад ашигладаг endpoint-ийг
# хориглоно. `OPENROUTER_ZDR=true` — зөвхөн мэдээлэл хадгалдаггүй endpoint (Gemini-д
# ийм endpoint байгаа эсэхийг эхлээд шалгана).
OPENROUTER_API_KEY=
OPENROUTER_ZDR=
# Google AI Studio-гийн төлбөртэй (billing идэвхтэй) project-ийн түлхүүр —
# үнэгүй tier-ийн өгөгдлийг Google сургалтад ашигладаг. Оюутанд бүү ашигла.
GEMINI_API_KEY=
# Ажил тус бүрийн загварын дараалал (`gemini:<model>`, таслалаар). Эхнийх нь үндсэн;
# тэр Google-ийн хязгаарт хүрсэн (429), ачаалалтай (503) эсвэл AI_MODEL_LIMITS-д
# ойртсон бол дараагийнх. Хоосон бол анхдагч (`apps/api/app/core/config.py`):
#   хүнд ажил  — 3.8 Flash → 3.5 Flash-Lite → 3.1 Flash-Lite
#   хөнгөн ажил — 3.5 Flash-Lite → 3.1 Flash-Lite → 3.8 Flash
# Шинэ загвар `apps/api/app/services/ai/prices.py`-д үнэтэй байх ёстой.
AI_DOCUMENT_MODELS=
AI_GUIDE_MODELS=
AI_TOPIC_QUIZ_MODELS=
AI_FULL_QUIZ_MODELS=
AI_EXAM_MODELS=
# Загварын хязгаар — Google AI Studio → Rate limits хуудаснаас (Google үлдэгдлийг
# API-аар хэлдэггүй). 90%-д хүрмэгц дараагийн загвар. Хоосон бол зөвхөн 429/503-аар.
# AI_MODEL_LIMITS={"gemini:gemini-3.8-flash": {"rpm": 1000, "tpm": 1000000, "rpd": 10000}}
AI_MODEL_LIMITS=
# Платформын сарын AI төсөв (USD). 95%-д хүрвэл шинэ AI ажил зогсоно. Хоосон бол 50.
AI_PLATFORM_MONTHLY_BUDGET_USD=
# Хэрэглэгчийн сарын хязгаар. Live нь зөвхөн Standard, Premium багцтай хэрэглэгчдэд
# (багцгүйд огт нээлттэй биш); Premium нь Standard дээр илүү AI. AI-ийн хязгаар нь
# USD, бүх ажлын нийлбэр — Gemini үнэ өөрчлөгдөхөд шинэчилнэ. `/pricing` Premium-ийг
# «N дахин их хэрэглээ» гэж материалын хязгаарын харьцаагаар бичнэ. Хоосон бол:
#   Standard: сард 20 материал, $3 · Premium: сард 60 материал, $7
#   Нэг удаагийн эрх: нэг материал, $0.75 (үнийг /admin/billing дээр)
LIVE_STANDARD_DOCUMENTS_PER_MONTH=
LIVE_STANDARD_AI_MONTHLY_USD=
LIVE_PREMIUM_DOCUMENTS_PER_MONTH=
LIVE_PREMIUM_AI_MONTHLY_USD=
LIVE_PASS_AI_USD=
# Эх файлын ХУВИЙН Cloudflare R2 bucket (нийтийн хандалтгүй). Cloudflare →
# R2 → Manage API tokens → зөвхөн энэ bucket-д Object Read & Write эрхтэй token.
LIVE_R2_ACCOUNT_ID=
LIVE_R2_ACCESS_KEY_ID=
LIVE_R2_SECRET_ACCESS_KEY=
LIVE_R2_BUCKET=
