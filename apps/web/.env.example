# Backend API-ийн суурь хаяг (/api/v1 prefix оруулаад бичнэ)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Server Component-ууд backend рүү дотоод сүлжээгээр хандах хаяг.
# Docker/Fly.io дээр internal hostname байж болно. Хоосон бол NEXT_PUBLIC_API_URL ашиглана.
API_INTERNAL_URL=http://localhost:8000/api/v1

# Сайтын нийтийн хаяг (metadata, canonical URL-д ашиглагдана)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Видео хостлох домэйнүүд (таслалаар тусгаарлана).
# HLS тоглуулагч сегментүүдийг fetch-ээр татдаг тул эдгээрийг CSP-д
# зөвшөөрөх шаардлагатай. Хоосон бол гадаад видео ачаалагдахгүй.
# NEXT_PUBLIC_MEDIA_ORIGINS=https://media.suralts.mn

# Хөгжүүлэлтийн серверийг дотоод сүлжээнээс нээх бол энэ компьютерийн IP
# (таслалаар тусгаарлана). Хамт ажиллагч http://<IP>:3000 гэж нээнэ.
# Мөн дээрх NEXT_PUBLIC_API_URL=/api/v1, API_PROXY_TARGET=http://localhost:8000
# болгож, API-г энэ сайтаар дамжуулна — эс бөгөөс тэдний хөтөч өөрийнхөө
# localhost:8000 руу хандана.
# ALLOWED_DEV_ORIGINS=192.168.1.14
