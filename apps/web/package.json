{
  "name": "medleghub-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "monaco:copy": "node scripts/copy-monaco.mjs",
    "predev": "node scripts/copy-monaco.mjs && node scripts/copy-pyodide.mjs && node scripts/build-react-sandbox.mjs && node scripts/generate-logo-manifest.mjs && node scripts/generate-badge-manifest.mjs",
    "prebuild": "node scripts/copy-monaco.mjs && node scripts/copy-pyodide.mjs && node scripts/build-react-sandbox.mjs && node scripts/generate-logo-manifest.mjs && node scripts/generate-badge-manifest.mjs",
    "e2e": "node e2e/student-journey.spec.mjs && node e2e/course-completion.spec.mjs && node e2e/python-course.spec.mjs && node e2e/flowgorithm-course.spec.mjs && node e2e/python-sandbox.spec.mjs && node e2e/native-sandbox.spec.mjs && node e2e/exercise.spec.mjs && node e2e/profile.spec.mjs && node e2e/sql-sandbox.spec.mjs && node e2e/sql-case.spec.mjs && node e2e/admin-journey.spec.mjs && node e2e/sandbox.spec.mjs && node e2e/lesson-layout.spec.mjs && node e2e/paywall.spec.mjs && node e2e/account.spec.mjs && node e2e/community.spec.mjs && node e2e/react-course.spec.mjs && node e2e/html-preview.spec.mjs && node e2e/promo-referral.spec.mjs && node e2e/announcements.spec.mjs && node e2e/payment-receipt.spec.mjs && npm run e2e:a11y",
    "e2e:student": "node e2e/student-journey.spec.mjs",
    "e2e:admin": "node e2e/admin-journey.spec.mjs",
    "e2e:sandbox": "node e2e/sandbox.spec.mjs",
    "e2e:a11y": "node e2e/a11y.spec.mjs && node e2e/a11y.spec.mjs --dark",
    "e2e:completion": "node e2e/course-completion.spec.mjs",
    "e2e:python": "node e2e/python-course.spec.mjs",
    "e2e:flowgorithm": "node e2e/flowgorithm-course.spec.mjs",
    "logos:manifest": "node scripts/generate-logo-manifest.mjs",
    "badges:manifest": "node scripts/generate-badge-manifest.mjs",
    "pyodide:copy": "node scripts/copy-pyodide.mjs",
    "sandbox:react": "node scripts/build-react-sandbox.mjs",
    "e2e:python-sandbox": "node e2e/python-sandbox.spec.mjs",
    "e2e:native": "node e2e/native-sandbox.spec.mjs",
    "e2e:exercise": "node e2e/exercise.spec.mjs",
    "e2e:profile": "node e2e/profile.spec.mjs",
    "verify:exercises": "cd ../api && python -m app.content.exercises | node ../web/scripts/verify-exercises.mjs",
    "verify:react": "node scripts/build-react-sandbox.mjs && cd ../api && python -m app.content.exercises --react | node ../web/scripts/verify-react-exercises.mjs",
    "e2e:sql": "node e2e/sql-sandbox.spec.mjs",
    "e2e:sql-case": "node e2e/sql-case.spec.mjs",
    "e2e:layout": "node e2e/lesson-layout.spec.mjs",
    "e2e:paywall": "node e2e/paywall.spec.mjs",
    "e2e:account": "node e2e/account.spec.mjs",
    "e2e:community": "node e2e/community.spec.mjs",
    "e2e:react": "node e2e/react-course.spec.mjs",
    "e2e:html": "node e2e/html-preview.spec.mjs",
    "e2e:promo": "node e2e/promo-referral.spec.mjs",
    "e2e:announcements": "node e2e/announcements.spec.mjs",
    "e2e:receipt": "node e2e/payment-receipt.spec.mjs",
    "e2e:live": "node e2e/live-study.spec.mjs",
    "test:worker": "node --test \"worker/**/*.test.mjs\"",
    "test:unit": "node --test \"tests/*.test.mjs\"",
    "og:image": "node scripts/generate-og-image.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "cf:build": "node scripts/cloudflare-build.mjs",
    "cf:preview": "node scripts/cloudflare-build.mjs && opennextjs-cloudflare preview",
    "cf:deploy": "node scripts/cloudflare-build.mjs && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@monaco-editor/react": "^4.7.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.45.0",
    "monaco-editor": "^0.56.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pyodide": "^314.0.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "video.js": "^8.24.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "acorn": "^8.18.0",
    "acorn-jsx": "^5.3.2",
    "axe-core": "^4.13.0",
    "esbuild": "^0.25.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-router": "^8.4.0",
    "sucrase": "^3.35.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.141.0"
  },
  "overrides": {
    "dompurify": "^3.4.13"
  }
}
