# Cloudflare Workers Static Assets-ийн header-ууд.
# `public/` доторх файлууд Next.js-ийн `headers()`-ээр ДАМЖИХГҮЙ — worker
# ажиллахаас өмнө шууд үйлчлэгддэг тул кэшийн дүрмийг энд давтана
# (`next.config.ts`-ийн `/monaco`, `/pyodide`-тай ижил шалтгаан).

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/monaco/*
  Cache-Control: public, max-age=31536000, immutable

/pyodide/*
  Cache-Control: public, max-age=31536000, immutable

# Нүүр хуудасны видео. Нэрээ солилгүй шинэ видеогоор солиход хэрэглэгчид
# нэг өдрийн дотор шинийг авна.
/videos/*
  Cache-Control: public, max-age=86400
