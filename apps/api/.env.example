# --- App ---------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# --- Database ----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://suralts:suralts@localhost:5432/suralts
DB_ECHO=false

# --- Security ----------------------------------------------------------
# Production: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRE_MINUTES=10080

# --- Auth cookie -------------------------------------------------------
# Production (HTTPS): AUTH_COOKIE_SECURE=true
# Frontend/backend өөр registrable domain дээр бол: AUTH_COOKIE_SAMESITE=none
AUTH_COOKIE_NAME=suralts_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=.medleghub.mn

# --- CORS --------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# --- Rate limiting -----------------------------------------------------
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Seed (development only) -------------------------------------------
SEED_ADMIN_EMAIL=admin@suralts.mn
SEED_ADMIN_PASSWORD=Admin12345

# --- C/C++ хөрвүүлэгч --------------------------------------------------
# Тусдаа `apps/compiler` үйлчилгээ. API нь кодыг зөвхөн дамжуулна.
# Локал дээр `docker compose up compiler` нь 8090 портод нээнэ.
COMPILER_URL=http://localhost:8090

# --- SQL ажиллуулагч ---------------------------------------------------
# Тусдаа `apps/sql-runner` үйлчилгээ — MySQL хичээлийн кодыг ажиллуулна.
# Локал дээр `docker compose up sql-runner` нь 8091 портод нээнэ.
SQL_RUNNER_URL=http://localhost:8091

# --- Standard багц (Wire төлбөр) ---------------------------------------
# https://docs.wire.mn. Хоосон бол төлбөр хүлээн авахгүй — хөгжүүлэлтэд
# төлбөрт хичээлийг `standard@suralts.mn` (seed) хэрэглэгчээр үзнэ.
WIRE_SECRET_KEY=
WIRE_WEBHOOK_SECRET=
# Test mode (`sk_test_…`): sandbox. Live (`sk_live_…`): qpay.
WIRE_ALLOWED_OPERATORS=sandbox
# Wire нь зөвхөн HTTPS буцах хаяг хүлээж авна — localhost үед буцах хаяг
# илгээхгүй, хэрэглэгч «Багц ба үнэ» хуудас руу гараар буцна.
SITE_URL=http://localhost:3000

# --- Имэйлийн код (Supabase Auth) --------------------------------------
# Хоосон бол имэйл баталгаажуулалт унтарна: бүртгүүлмэгц нэвтэрч, нууц үг
# сэргээх боломжгүй. Тохируулбал жинхэнэ имэйл илгээгдэнэ.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- MedlegHub Live (AI Study) -----------------------------------------
# `off` / `admins` / `all`. Локал дээр турших бол `all`.
LIVE_ACCESS=off
# Файл задлагч (`docker compose up extractor` → 8092).
EXTRACTOR_URL=http://localhost:8092
# AI: OPENROUTER_API_KEY байвал OpenRouter, үгүй бол GEMINI_API_KEY (Google шууд).
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Ажил тус бүрийн загварын дараалал ба хязгаар — `.env.prod.example`-ийг үз.
# Түлхүүргүй турших бол бүх ажилд хуурамч AI (production-д хориотой):
# AI_MODELS=fake:local
# Эх файл: хоосон бол `LIVE_STORAGE_DIR` хавтас (production-д R2 заавал).
LIVE_STORAGE_DIR=var/live-storage
